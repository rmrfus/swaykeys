#!/usr/bin/env bash
#
# Lint what is about to be committed, not what happens to be on disk.
#
# Enable it per clone, once:
#
#     git config core.hooksPath hooks
#
# The index is checked out into a temp directory and every check runs there.
# Running in the working tree instead would read unstaged edits, so a fix you
# have made but not staged makes a broken hunk look clean and it lands anyway —
# which is the one failure a pre-commit hook exists to prevent.
#
# `--no-verify` skips this. That is the escape hatch; there is no other.

set -Eeuo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
readonly REPO_ROOT

# A fixed path, not mktemp, and a build directory of its own. Both matter:
#
#   * fixed, because `env!("CARGO_MANIFEST_DIR")` is baked in at compile time
#     and cargo keys its units on the source path. A fresh temp directory every
#     run means nothing is ever reused and the tests carry a dead path.
#   * separate from the repo's own target/, because a shared one leaves the
#     working tree running units this hook compiled: `cargo test` then fails
#     with `/tmp/tmp.XXXX/tests/fixtures/...: No such file or directory`, and
#     touching any source file makes it go away again. An hour of your life.
readonly WORK="${REPO_ROOT}/target/pre-commit"

log() {
    echo "pre-commit: $*" >&2
}

die() {
    log "ERROR: $*"
    exit 1
}

# Quiet on success, everything on failure. A hook that prints 90 lines of
# passing tests on every commit is a hook whose one line of real output nobody
# reads.
run() {
    local what="$1"
    shift
    local out
    out="$(mktemp)"
    log "${what}"
    if ! nix develop --no-warn-dirty "${REPO_ROOT}" --command "$@" >"${out}" 2>&1; then
        cat "${out}" >&2
        rm -f "${out}"
        die "${what} failed"
    fi
    rm -f "${out}"
}

main() {
    command -v nix >/dev/null 2>&1 || die "required: nix (the toolchain comes from the flake)"

    local staged="${WORK}/src"
    # Wiped rather than reused: a file deleted from the index has to disappear
    # here too, or it keeps being compiled.
    rm -rf "${WORK:?}/src"
    mkdir -p "${staged}"

    git checkout-index --all --force --prefix="${staged}/"

    export CARGO_TARGET_DIR="${WORK}/target"

    # Every check the same way CI runs it, --locked included: a hook that
    # silently updates Cargo.lock is not checking the build CI will run. No
    # path filtering — three seconds on a warm cache is cheaper than a hook
    # whose skip conditions have to be reasoned about at three in the morning.
    cd "${staged}"

    run fmt cargo fmt --all --check
    run clippy cargo clippy --all-targets --locked -- -D warnings
    run test cargo test --locked
    run man groff -man -Tutf8 -ww -z man/man1/swaykeys.1

    log "ok"
}

main "$@"
