# Mode blocks, including one with a nested block inside it. Counting braces
# and resetting to "default" on every `}` gets this wrong.
set $mod Mod4

bindsym $mod+r mode "resize"

mode "resize" {
    bindsym h resize shrink width 10px
    bindsym l resize grow width 10px

    # A nested block inside a mode. The `}` that closes it must not end the
    # mode — the binding after it still belongs to "resize".
    input "type:keyboard" {
        repeat_delay 300
    }

    bindsym Escape mode "default"
}

# The brace may sit on its own line.
mode "passthrough"
{
    bindsym $mod+Pause mode "default"
}

# A bar block also uses bindsym, but for bar buttons — not our business.
bar {
    bindsym button2 kill
}

bindsym $mod+q kill
