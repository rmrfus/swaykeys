# Backslash continuation. Dropping it loses the tail of the command silently,
# which is the worst possible failure for a help sheet.
set $mod Mod4

bindsym $mod+e exec swaynag \
    -t warning \
    -m 'really exit?'

# A comment line never continues, so the binding below is its own line.
# not a continuation \
bindsym $mod+c exec after-comment
