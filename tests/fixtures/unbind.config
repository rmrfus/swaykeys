# unbind* reaches into one list only — the same list its own flags put it in.
set $mod Mod4

bindsym $mod+space focus mode_toggle
bindcode 65 exec by-keycode
bindsym --to-code $mod+f fullscreen

# Hits the keysym list, leaving the keycode binding alone.
unbindsym $mod+space

# Wrong list: this looks for a keysym binding of $mod+f, but --to-code put it
# in the keycode list, so nothing is removed.
unbindsym $mod+f

bindsym $mod+k exec survivor
