# `--to-code` is a request, not a guarantee.
#
# sway translates each keysym to a keycode and keeps the binding in the keycode
# list only if every one resolves to exactly *one* keycode. Print does not: the
# stock us layout puts it on both <PRSC> and <I218>. So this binding stays in
# the keysym list and overwrites the plain bindsym above it — the opposite of
# what the flag looks like it does.
set $mod Mod4

input * {
    xkb_layout us
}

bindsym Print exec theirs
bindsym --to-code Print exec ours

# For contrast: `d` is on exactly one keycode, so this one does reach the
# keycode list.
bindsym --to-code $mod+d exec resolves
