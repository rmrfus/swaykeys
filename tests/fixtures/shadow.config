# Cross-list shadowing. A fixed layout so the keycodes are deterministic.
set $mod Mod4

input * {
    xkb_layout us
}

# The ticket's motivating case: both survive parsing, in different lists, and
# the keycode one is what actually fires.
bindsym $mod+d exec default-menu
bindsym --to-code $mod+d exec our-menu

# Press and release are looked up in separate passes, so this one is not
# shadowed by anything above.
bindsym --release $mod+d exec on-release

# A device-specific binding outranks `*` only for events from that device,
# which is a runtime fact we cannot see. Neither direction may be claimed.
bindsym --input-device=1:1:keeb $mod+g exec device-specific
bindsym --to-code $mod+g exec generic

# Same keycode reached two ways: `bindcode 51` and `--to-code backslash` are
# one binding as far as sway is concerned, so the second replaces the first.
bindcode $mod+51 exec by-raw-code
bindsym --to-code $mod+backslash exec by-name

# Nothing competes with this one.
bindsym --to-code $mod+y exec lonely
