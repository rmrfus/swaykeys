# Variable substitution corner cases.
set $mod Mod4
set $mod2 Mod1
set $term foot

# $mod2 must win over $mod even though $mod was defined first: symbols are
# matched longest-name-first, not by word boundary.
bindsym $mod2+t exec $term

# A value is expanded once, at definition time, so $indirect captures "foot"
# rather than a reference to $term.
set $indirect $term

# Redefinition applies from here on — and does not reach back into $indirect,
# which already captured the old value. No fixpoint iteration happens.
set $term alacritty
bindsym $mod+i exec $indirect
bindsym $mod+t exec $term

# Unknown variables are left alone rather than silently dropped.
bindsym $mod+u exec $nosuchvar

# $$ is a literal dollar, \$ is escaped.
bindsym $mod+d exec echo $$mod
