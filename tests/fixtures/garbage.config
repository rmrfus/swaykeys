# Lines that look like bindings but are not usable. Every one of these must be
# reported, never silently dropped.
set $mod Mod4

bindsym
bindsym $mod+
unbindsym $mod+a exec nope
bindsym Group9+a exec bad-group

# These are fine and must survive alongside the noise.
bindsym $mod+a exec good
bindsym --to-code --no-warn $mod+b exec also-good
